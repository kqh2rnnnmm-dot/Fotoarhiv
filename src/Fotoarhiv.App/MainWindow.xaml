        <ItemsControl x:Name="DetailMetadata"><ItemsControl.ItemTemplate><DataTemplate><Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Margin="0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" FontSize="12" Foreground="#8A96A5" TextWrapping="Wrap" Margin="0,0,10,0"/><TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" FontWeight="SemiBold" TextAlignment="Right" TextWrapping="Wrap"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Border Height="1" Background="{StaticResource Line}" Margin="0,20"/><TextBlock x:Name="DetailAvailability" FontSize="12" Foreground="#527299" TextWrapping="Wrap"/><Button x:Name="DetailMapAction" Content="Открыть GPS на карте" Click="DetailMap_Click" Margin="0,16,0,0" HorizontalAlignment="Left"/><TextBlock x:Name="DetailMapWarning" Text="По нажатию координаты будут переданы OpenStreetMap." FontSize="11" Foreground="#8391A2" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></ScrollViewer></Border>
