      <Border x:Name="ArchivePanel" Width="720" MaxHeight="740" VerticalAlignment="Center" HorizontalAlignment="Center" Background="White" CornerRadius="22" Padding="31,28" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="0,0,0,22"><StackPanel Margin="0,0,40,0"><TextBlock x:Name="ArchiveTitle" Text="Собрать архив" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Режимы организации архива. Файловые операции пока недоступны." FontSize="12" Foreground="#8792A2" Margin="0,9,0,0" TextWrapping="Wrap"/></StackPanel><Button x:Name="ArchiveClose" Style="{StaticResource IconButton}" Click="CloseOverlay_Click" HorizontalAlignment="Right" VerticalAlignment="Top" AutomationProperties.Name="Закрыть окно архива"><local:ReferenceIcon Kind="close"/></Button></Grid><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><UniformGrid Rows="1" Columns="2" Margin="-6,0,-6,22"><Button x:Name="ArchiveCopyMode" IsEnabled="False" Background="#F4F7FF" BorderBrush="#3970F7" HorizontalContentAlignment="Stretch" Padding="18" Margin="6,0" MinHeight="94"><StackPanel><StackPanel Orientation="Horizontal"><local:ReferenceIcon Kind="copy" Foreground="#3B71EB" Margin="0,0,12,0"/><TextBlock Text="Создать копии" FontSize="13" FontWeight="SemiBold"/></StackPanel><TextBlock Text="Оригиналы останутся в исходных папках.&#10;В разработке" FontSize="11" Foreground="#8794A3" TextWrapping="Wrap" Margin="31,6,0,0"/></StackPanel></Button><Button x:Name="ArchiveMoveMode" IsEnabled="False" HorizontalContentAlignment="Stretch" Padding="18" Margin="6,0" MinHeight="94"><StackPanel><StackPanel Orientation="Horizontal"><local:ReferenceIcon Kind="move" Foreground="#3B71EB" Margin="0,0,12,0"/><TextBlock Text="Переместить" FontSize="13" FontWeight="SemiBold"/></StackPanel><TextBlock Text="Собрать исходники в одном месте.&#10;В разработке" FontSize="11" Foreground="#8794A3" TextWrapping="Wrap" Margin="31,6,0,0"/></StackPanel></Button></UniformGrid><TextBlock Text="Куда собрать фотографии" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,9"/><Border Background="#FBFCFE" BorderBrush="#DFE6EF" BorderThickness="1" CornerRadius="11" Padding="12" Height="47"><StackPanel Orientation="Horizontal"><local:ReferenceIcon Kind="folder" Foreground="#8794A3"/><TextBlock Text="Выбор папки станет доступен позже" FontSize="12" Foreground="#96A2B1" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel></Border><Border Background="#F6F8FB" CornerRadius="13" Padding="19,16" Margin="0,18,0,0"><StackPanel><TextBlock Text="Предварительная структура" FontSize="12" FontWeight="SemiBold" Foreground="#394A60"/><TextBlock Text="План ещё не рассчитан" FontSize="13" Foreground="#647488" Margin="12,18,0,8"/><TextBlock Text="Структура появится после реализации предварительного просмотра. В этой версии назначения и объём копирования не вычисляются." Style="{StaticResource MutedText}" Margin="12,0,12,12"/></StackPanel></Border><Border Background="#FFF8E8" BorderBrush="#F6E9C8" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,18,0,0"><TextBlock Text="Эта версия не копирует, не перемещает и не удаляет фотографии. Режимы появятся после отдельной проверки безопасности." FontSize="11" Foreground="#817253" TextWrapping="Wrap"/></Border></StackPanel></ScrollViewer><Grid Grid.Row="2" Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Файловые операции недоступны" FontSize="11" Foreground="#9DA8B4" VerticalAlignment="Center" TextWrapping="Wrap"/><Button Grid.Column="1" Content="Закрыть" Click="CloseOverlay_Click" Margin="10,0,0,0"/><Button x:Name="ArchivePlanAction" Grid.Column="2" Content="Посмотреть план" Style="{StaticResource PrimaryButton}" IsEnabled="False" Margin="10,0,0,0"/></Grid></Grid></Border>
      <Border x:Name="ComparisonPanel" Width="720" MaxHeight="650" Padding="31,28" CornerRadius="22" Background="White" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" KeyboardNavigation.TabNavigation="Cycle"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><StackPanel Margin="0,0,40,0"><TextBlock Text="Сравнение точных копий" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Совпадение подтверждено SHA-256. Все файлы сохранены." Style="{StaticResource MutedText}" Margin="0,9,0,20"/></StackPanel><Button x:Name="ComparisonClose" Style="{StaticResource IconButton}" Click="CloseOverlay_Click" HorizontalAlignment="Right" VerticalAlignment="Top" AutomationProperties.Name="Закрыть сравнение"><local:ReferenceIcon Kind="close"/></Button></Grid><ListBox x:Name="DuplicateMembers" Grid.Row="1" MinHeight="160" MaxHeight="360" BorderBrush="{StaticResource Line}" BorderThickness="1" FontSize="12" DisplayMemberPath="Path" MouseDoubleClick="DuplicateMember_Click" ScrollViewer.HorizontalScrollBarVisibility="Auto"/><TextBlock Grid.Row="2" Text="Дважды щёлкните файл, чтобы посмотреть сведения. Изменений в оригиналах не будет." Style="{StaticResource MutedText}" Margin="0,20,0,0"/></Grid></Border>
