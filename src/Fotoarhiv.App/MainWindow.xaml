<Window x:Class="Fotoarhiv.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Fotoarhiv.App" x:Name="RootWindow"
        Title="Фотоархив" Width="1456" Height="939" MinWidth="760" MinHeight="480" WindowStartupLocation="CenterScreen" Background="{StaticResource Canvas}" FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource Ink}" UseLayoutRounding="True" PreviewKeyDown="Window_KeyDown" SizeChanged="Window_SizeChanged">
  <Window.Resources>
    <DataTemplate x:Key="PhotoTileTemplate">
      <Grid Loaded="PhotoPreview_Loaded" Tag="gallery">
        <Button Style="{StaticResource PhotoButton}" Click="Photo_Click" AutomationProperties.Name="{Binding Name}" ToolTip="{Binding Photo.Path}">
          <Grid><Border x:Name="PhotoMask" Background="White" CornerRadius="13"/>
            <Grid><Grid.OpacityMask><VisualBrush Visual="{Binding ElementName=PhotoMask}"/></Grid.OpacityMask>
              <Border Background="#EAF0F6"/><local:ReferenceIcon Kind="images" Width="32" Height="32" Foreground="#A1AFC0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
              <Rectangle Height="70" VerticalAlignment="Bottom"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#99000000" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
              <StackPanel VerticalAlignment="Bottom" Margin="11,0,11,10"><TextBlock Text="{Binding Caption}" Foreground="White" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Источник недоступен" Foreground="#F4E9D0" FontSize="10" Margin="0,3,0,0" Visibility="{Binding UnavailableVisibility}"/></StackPanel>
              <Border CornerRadius="7" Background="#AD0C1826" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="9" Padding="7,4" Visibility="{Binding DuplicateVisibility}"><StackPanel Orientation="Horizontal"><local:ReferenceIcon Kind="layers" Width="11" Height="11" Foreground="White" Margin="0,0,4,0"/><TextBlock Text="{Binding DuplicateCount}" Foreground="White" FontSize="10" FontWeight="SemiBold"/></StackPanel></Border>
            </Grid>
          </Grid>
        </Button>
        <Border CornerRadius="13" BorderBrush="{StaticResource Accent}" BorderThickness="3" Visibility="{Binding SelectedVisibility}" IsHitTestVisible="False"/>
        <CheckBox Style="{StaticResource PhotoSelectionCheckBox}" IsChecked="{Binding IsSelected, Mode=OneWay}" Checked="Selection_Click" Unchecked="Selection_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9" AutomationProperties.Name="{Binding SelectionName}" ToolTip="Выделить фотографию"/>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="DuplicatePreviewTemplate">
      <StackPanel Margin="0,0,9,0"><Button Loaded="PhotoPreview_Loaded" Tag="duplicate" Height="128" Style="{StaticResource PhotoButton}" Click="Photo_Click" AutomationProperties.Name="{Binding Name}" ToolTip="{Binding Photo.Path}"><Grid><Border x:Name="DupeMask" Background="#EDF2F8" CornerRadius="10"/><Grid><Grid.OpacityMask><VisualBrush Visual="{Binding ElementName=DupeMask}"/></Grid.OpacityMask><local:ReferenceIcon Kind="images" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#A1AFC0"/><Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/></Grid></Grid></Button><TextBlock Text="{Binding Name}" FontSize="10" Foreground="#7C889B" TextTrimming="CharacterEllipsis" Margin="0,7,0,0"/><TextBlock Text="{Binding SizeLabel}" FontSize="10" FontWeight="SemiBold" Foreground="#415065"/></StackPanel>
    </DataTemplate>
  </Window.Resources>
  <Grid x:Name="RootGrid">
    <Grid x:Name="MainShell">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border x:Name="Sidebar" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
        <Grid x:Name="SidebarLayout" Margin="15,29,15,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel x:Name="Brand" Orientation="Horizontal" Margin="12,0,0,44"><Border Width="31" Height="31" CornerRadius="10" Background="#3169F6"><local:ReferenceIcon Kind="images" Width="20" Height="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="BrandName" VerticalAlignment="Center" FontSize="21" FontWeight="Bold" Margin="11,0,0,0">фотоархив<Run Foreground="#366DF3">.</Run></TextBlock></StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel><TextBlock x:Name="NavigationHeading" Text="БИБЛИОТЕКА" Foreground="#A4ACB8" FontSize="10" FontWeight="Bold" Margin="15,0,0,12"/>
              <Button x:Name="NavPhotos" Style="{StaticResource NavButton}" Click="NavigatePhotos_Click" AutomationProperties.Name="Фотографии"><StackPanel Orientation="Horizontal"><local:ReferenceIcon Kind="grid"/><TextBlock x:Name="NavPhotosLabel" Text="Фотографии" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="13,0,0,0"/></StackPanel></Button>
              <Button x:Name="NavPlaces" Style="{StaticResource NavButton}" Click="NavigatePlaces_Click" AutomationProperties.Name="Карта"><StackPanel Orientation="Horizontal"><local:ReferenceIcon Kind="map"/><TextBlock x:Name="NavPlacesLabel" Text="Карта" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="13,0,0,0"/></StackPanel></Button>
              <Button x:Name="NavDuplicates" Style="{StaticResource NavButton}" Click="NavigateDuplicates_Click" AutomationProperties.Name="Повторы"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><local:ReferenceIcon Kind="layers"/><TextBlock x:Name="NavDuplicatesLabel" Grid.Column="1" Text="Повторы" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="13,0,0,0"/><Border x:Name="DuplicateBadge" Grid.Column="2" CornerRadius="10" Background="#F0F3F9" Padding="6,2" VerticalAlignment="Center"><TextBlock x:Name="DuplicateBadgeText" FontSize="10" Foreground="#8190A5" Text="—"/></Border></Grid></Button>
              <Button x:Name="NavAlbums" Style="{StaticResource NavButton}" Click="NavigateAlbums_Click" AutomationProperties.Name="Альбомы"><StackPanel Orientation="Horizontal"><local:ReferenceIcon Kind="images"/><TextBlock x:Name="NavAlbumsLabel" Text="Альбомы" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="13,0,0,0"/></StackPanel></Button>
              <Button x:Name="NavSources" Style="{StaticResource NavButton}" Click="NavigateSources_Click" AutomationProperties.Name="Источники"><StackPanel Orientation="Horizontal"><local:ReferenceIcon Kind="harddrive"/><TextBlock x:Name="NavSourcesLabel" Text="Источники" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="13,0,0,0"/></StackPanel></Button>
              <StackPanel x:Name="SidebarSourcesPanel" Margin="0,35,0,0"><TextBlock Text="ИСТОЧНИКИ" Foreground="#A4ACB8" FontSize="10" FontWeight="Bold" Margin="15,0,0,12"/><ItemsControl x:Name="SidebarSources"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="12,0,12,10" ToolTip="{Binding FullPath}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><local:ReferenceIcon Kind="harddrive" Width="14" Height="14" Foreground="#7A8799"/><TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Foreground="#7A8799" Margin="8,0,8,0" TextTrimming="CharacterEllipsis"/><Ellipse Grid.Column="2" Width="6" Height="6" Fill="{Binding StatusBrush}" VerticalAlignment="Center" ToolTip="{Binding Status}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="NoSidebarSources" Text="Пока нет источников" FontSize="12" Foreground="#9AA4B2" Margin="12,0,0,0"/></StackPanel>
            </StackPanel>
          </ScrollViewer>
          <Border x:Name="SidebarBottom" Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="11,20,11,0"><StackPanel><Border HorizontalAlignment="Left" Background="#F3F5F8" BorderBrush="#EAEDF2" BorderThickness="1" CornerRadius="16" Padding="10,8"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#53BC9B" Margin="0,0,7,0"/><TextBlock Text="Локальный каталог" FontSize="11" Foreground="#637083"/></StackPanel></Border><TextBlock Text="Фото остаются в исходных папках. Каталог хранится на этом компьютере." FontSize="11" LineHeight="18" Foreground="#9AA4B2" TextWrapping="Wrap" Margin="0,12,0,0"/><TextBlock Text="Версия 0.2.3 · тестовая" FontSize="10" Foreground="#A4ACB8" Margin="0,7,0,0"/></StackPanel></Border>
        </Grid>
      </Border>
      <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="87"/><RowDefinition Height="*"/><RowDefinition Height="40"/></Grid.RowDefinitions>
        <Border x:Name="Topbar" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"><Grid x:Name="TopbarLayout" Margin="33,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border x:Name="SearchFrame" Width="500" MaxWidth="500" Height="45" Background="#F4F6F9" CornerRadius="12" Padding="13,0" HorizontalAlignment="Left"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="19"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><local:ReferenceIcon Kind="search" Foreground="#929CAC" VerticalAlignment="Center"/><Grid Grid.Column="1" Margin="10,0,0,0"><TextBox x:Name="SearchBox" FocusVisualStyle="{StaticResource KeyboardFocus}" BorderThickness="0" Background="Transparent" Foreground="#2A3546" CaretBrush="{StaticResource Accent}" FontSize="13" VerticalContentAlignment="Center" TextChanged="Search_Changed" AutomationProperties.Name="Поиск по имени и пути"/><TextBlock Text="Найти по имени или пути…" Foreground="#A4AEBA" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Grid></Border>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="19,0,0,0"><Button x:Name="AddFolderAction" Click="AddFolder_Click" AutomationProperties.Name="Добавить папку" ToolTip="Добавить папку"><StackPanel Orientation="Horizontal"><local:ReferenceIcon Kind="plus" Width="17" Height="17"/><TextBlock x:Name="AddFolderLabel" Text="Добавить папку" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="9,0,0,0"/></StackPanel></Button><Button x:Name="ArchiveAction" Style="{StaticResource PrimaryButton}" Click="ExportPlaceholder_Click" Margin="10,0,0,0" AutomationProperties.Name="Собрать архив" ToolTip="Собрать архив — режимы в разработке"><StackPanel Orientation="Horizontal"><local:ReferenceIcon Kind="download" Width="17" Height="17"/><TextBlock x:Name="ArchiveLabel" Text="Собрать архив" Foreground="White" Margin="9,0,0,0"/></StackPanel></Button></StackPanel>
        </Grid></Border>
        <ScrollViewer x:Name="PageScroll" ScrollChanged="PageScroll_Changed" Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="PageContent" Margin="35,34,35,35">
          <Grid Margin="0,0,0,25"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageTitle" Text="Фотографии" FontSize="29" FontWeight="Bold" LineHeight="35" LineStackingStrategy="BlockLineHeight"/><TextBlock x:Name="PageSubtitle" Text="Вся коллекция в одной хронологии — независимо от папки и диска." FontSize="13" Foreground="#8A96A5" Margin="0,9,0,0" LineHeight="16" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"/></StackPanel><Border x:Name="SafetyBadge" Grid.Column="1" Background="#EAF0F9" CornerRadius="12" Padding="13,11" VerticalAlignment="Top" Margin="20,0,0,0"><StackPanel Orientation="Horizontal"><local:ReferenceIcon Kind="shield" Width="16" Height="16" Foreground="#4875DC" Margin="0,0,8,0"/><TextBlock Text="Оригиналы под защитой" Foreground="#6A7890" FontSize="12"/></StackPanel></Border></Grid>
          <StackPanel x:Name="PhotosPanel">
            <ItemsControl x:Name="StatsCards" Margin="-7,0,-7,14"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding StatsColumns, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Margin="7,0,7,14" Padding="20,18" MinHeight="95" Background="White" BorderBrush="#EBEFF5" BorderThickness="1" CornerRadius="15"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="42" Height="42" Background="#F1F5FF" CornerRadius="13" Margin="0,0,14,0"><local:ReferenceIcon Kind="{Binding Icon}" Foreground="#4777EB" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Value}" FontSize="22" FontWeight="Bold" AutomationProperties.AutomationId="{Binding AutomationId}"/><TextBlock Text="{Binding Label}" FontSize="11" Foreground="#93A0AF" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <Grid x:Name="Filters" Margin="0,0,0,16">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ListBox x:Name="YearPicker" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource YearChip}" SelectionChanged="Year_Changed" AutomationProperties.Name="Год фотографий"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
              <StackPanel x:Name="SortLabel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0"><Button x:Name="SortAction" Click="Sort_Click" MinHeight="34" Height="34" Padding="12,0" FontSize="12" ToolTip="Изменить порядок хронологии"><StackPanel Orientation="Horizontal"><local:ReferenceIcon Kind="filter" Width="15" Height="15" Foreground="#778396"/><TextBlock x:Name="SortText" Text="Сначала новые" FontSize="12" Foreground="#637187" Margin="6,0,0,0"/></StackPanel></Button></StackPanel>
              <Border x:Name="SelectionBar" Grid.Row="1" Grid.ColumnSpan="2" Background="#EBF1FF" CornerRadius="10" Padding="12,6" Margin="0,5,0,0" Visibility="Collapsed"><Grid><TextBlock x:Name="SelectionCount" Text="Выбрано: 0" FontSize="12" Foreground="#3368F0" VerticalAlignment="Center"/><Button x:Name="ClearSelectionAction" Content="Снять выделение" Click="ClearSelection_Click" IsEnabled="False" Background="Transparent" BorderThickness="0" MinHeight="28" Height="28" FontSize="12" Foreground="#3368F0" HorizontalAlignment="Right"/></Grid></Border>
            </Grid>
            <ItemsControl x:Name="PhotosGallery"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,20"><StackPanel Orientation="Horizontal" Margin="0,0,0,15"><TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" LineHeight="20" LineStackingStrategy="BlockLineHeight"/><TextBlock Text="{Binding CountLabel}" FontSize="12" Foreground="#96A1AF" VerticalAlignment="Bottom" Margin="12,0,0,1"/></StackPanel><ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource PhotoTileTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><local:ReferenceTilePanel Columns="{Binding PhotoColumns, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Gap="12" AspectRatio="1.12"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <Border x:Name="PhotosEmpty" MinHeight="260" Background="White" BorderBrush="#DBE2ED" BorderThickness="1" CornerRadius="17"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"><local:ReferenceIcon Kind="images" Width="32" Height="32" Foreground="#8390A3" HorizontalAlignment="Center"/><TextBlock x:Name="PhotosEmptyTitle" Text="Добавьте фотографии" FontSize="18" FontWeight="SemiBold" Foreground="#4C5B6E" HorizontalAlignment="Center" Margin="0,12,0,5"/><TextBlock x:Name="PhotosEmptyText" Text="Выберите папку — оригиналы останутся на своих местах." FontSize="12" Foreground="#8390A3" TextAlignment="Center" TextWrapping="Wrap"/><Button x:Name="PhotosEmptyAction" Content="Добавить папку" Click="EmptyPhotos_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,20,0,0"/></StackPanel></Border>
          </StackPanel>
          <Grid x:Name="PlacesPanel" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition x:Name="MapLeftColumn" Width="2.25*"/><ColumnDefinition x:Name="MapGapColumn" Width="20"/><ColumnDefinition x:Name="MapRightColumn" Width="*" MinWidth="280"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border x:Name="MapCard" Background="#F3F7FB" CornerRadius="18" BorderBrush="#E7ECF2" BorderThickness="1" Padding="20" MinHeight="430"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><TextBlock Text="Карта коллекции" FontWeight="SemiBold" FontSize="13" Foreground="#38475A"/><TextBlock Text="По данным EXIF" FontSize="12" Foreground="#657187" HorizontalAlignment="Right"/></Grid><StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15"><local:ReferenceIcon Kind="map" Width="52" Height="52" Foreground="#A1B4CA" HorizontalAlignment="Center"/><TextBlock Text="Интерактивная карта появится позже" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,18,0,8"/><TextBlock Text="Снимки с координатами EXIF доступны в списке справа.&#10;Карта открывается в браузере только по вашему действию." FontSize="12" LineHeight="19" Foreground="#8391A2" TextAlignment="Center" TextWrapping="Wrap"/></StackPanel><TextBlock Grid.Row="2" Text="География не определяется и не отправляется автоматически" FontSize="11" Foreground="#8391A2" TextWrapping="Wrap"/></Grid></Border>
            <Border x:Name="GpsCard" Grid.Column="2" Background="White" BorderBrush="#E7ECF2" BorderThickness="1" CornerRadius="18" Padding="18" MinHeight="430"><StackPanel><TextBlock Text="Места из коллекции" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Только координаты, найденные в метаданных фотографий." Foreground="#8391A2" FontSize="12" Margin="0,18,0,12" TextWrapping="Wrap"/><ListBox x:Name="PlacesList" Height="232" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource GpsItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Places_Changed"><ListBox.ItemTemplate><DataTemplate><Grid Loaded="GpsPreview_Loaded"><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#EDF2F8" CornerRadius="8" Height="54"><Image Source="{Binding Tile.Thumbnail}" Stretch="UniformToFill"/></Border><StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding Photo.Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Coordinates}" FontSize="10" Foreground="#9AA4B1" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="NoGpsText" Text="В каталоге пока нет снимков с GPS." Style="{StaticResource MutedText}" Margin="0,0,0,12"/><Button x:Name="OpenMapAction" Content="Открыть точку на карте" Click="OpenMap_Click" FontSize="12" HorizontalAlignment="Left"/><Border Background="#F5F8FC" CornerRadius="12" Padding="12" Margin="0,16,0,0"><TextBlock Text="Координаты выбранного снимка будут переданы OpenStreetMap только по нажатию кнопки." FontSize="11" Foreground="#7C8BA0" TextWrapping="Wrap"/></Border></StackPanel></Border>
          </Grid>
          <StackPanel x:Name="DuplicatesPanel" Visibility="Collapsed">
            <Border Background="#F0F5FF" BorderBrush="#E3EDFF" BorderThickness="1" CornerRadius="14" Padding="20,16" Margin="0,0,0,20"><StackPanel Orientation="Horizontal"><local:ReferenceIcon Kind="shield" Foreground="#4674EB" Margin="0,0,12,0"/><TextBlock Text="Точные совпадения по SHA-256. Фотографии не удаляются и не перемещаются." FontSize="12" Foreground="#546C91" TextWrapping="Wrap" VerticalAlignment="Center"/></StackPanel></Border>
            <WrapPanel Margin="0,0,0,24"><Button x:Name="AllDuplicatesFilter" Content="Все группы" Click="DuplicateFilter_Click" Tag="all" MinHeight="34" Height="34" FontSize="12" Padding="15,0" Margin="0,0,9,8"/><Button x:Name="ExactDuplicatesFilter" Content="Точные копии" Click="DuplicateFilter_Click" Tag="exact" MinHeight="34" Height="34" FontSize="12" Padding="15,0" Margin="0,0,9,8"/><Button Content="Разные версии · позже" IsEnabled="False" MinHeight="34" Height="34" FontSize="12" Padding="15,0" Margin="0,0,9,8" ToolTip="Распознавание версий ещё не реализовано"/><Button Content="Похожие кадры · позже" IsEnabled="False" MinHeight="34" Height="34" FontSize="12" Padding="15,0" Margin="0,0,0,8" ToolTip="Визуальное сходство ещё не реализовано"/></WrapPanel>
            <ItemsControl x:Name="DuplicateGroups"><ItemsControl.ItemsPanel><ItemsPanelTemplate><local:ReferenceTilePanel Columns="{Binding DupeColumns, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Gap="17" AspectRatio="0"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="#E8ECF3" BorderThickness="1" CornerRadius="16" Padding="19"><StackPanel><TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Точные копии · имена и папки могут отличаться" FontSize="12" Foreground="#97A2B0" Margin="0,4,0,14" TextWrapping="Wrap"/><ItemsControl ItemsSource="{Binding PreviewPhotos}" ItemTemplate="{StaticResource DuplicatePreviewTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl><Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Footer}" FontSize="11" Foreground="#8A97A8" VerticalAlignment="Center" TextWrapping="Wrap"/><Button Grid.Column="1" Click="CompareGroup_Click" BorderThickness="0" Padding="0" MinHeight="26" Foreground="#2E69ED" AutomationProperties.Name="{Binding CompareName}"><StackPanel Orientation="Horizontal"><TextBlock Text="Сравнить" Foreground="#2E69ED" FontWeight="SemiBold" FontSize="12"/><local:ReferenceIcon Kind="arrow" Width="15" Height="15" Foreground="#2E69ED" Margin="6,0,0,0"/></StackPanel></Button></Grid></Border></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <Border x:Name="DuplicatesEmpty" Background="White" BorderBrush="#DBE2ED" BorderThickness="1" CornerRadius="17" MinHeight="260"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"><local:ReferenceIcon Kind="layers" Width="32" Height="32" HorizontalAlignment="Center" Foreground="#8390A3"/><TextBlock x:Name="DuplicatesEmptyTitle" Text="Проверьте точные повторы" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,5" TextAlignment="Center"/><TextBlock x:Name="DuplicatesEmptyText" Text="Нажмите «Обновить». Сравнение не изменяет фотографии." Style="{StaticResource MutedText}" TextAlignment="Center"/></StackPanel></Border>
          </StackPanel>
          <Border x:Name="AlbumsPanel" Visibility="Collapsed" Background="White" BorderBrush="#DBE2ED" BorderThickness="1" CornerRadius="17" MinHeight="300"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"><local:ReferenceIcon Kind="images" Width="40" Height="40" Foreground="#8390A3" HorizontalAlignment="Center"/><TextBlock Text="Альбомы появятся позже" FontSize="18" FontWeight="SemiBold" Margin="0,14,0,7" TextAlignment="Center"/><TextBlock Text="Здесь будут подборки без физических копий файлов.&#10;Пока все фотографии доступны в общей хронологии." Style="{StaticResource MutedText}" TextAlignment="Center"/></StackPanel></Border>
          <StackPanel x:Name="SourcesPanel" Visibility="Collapsed">
            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SourceVisibilitySummary" FontSize="12" Foreground="#798494" VerticalAlignment="Center"/><WrapPanel Grid.Column="1"><Button x:Name="ShowAllSourcesAction" Content="Показать все" Click="ShowAllSources_Click" MinHeight="34" Height="34" FontSize="12" Margin="0,0,8,0"/><Button x:Name="HideAllSourcesAction" Content="Скрыть все" Click="HideAllSources_Click" MinHeight="34" Height="34" FontSize="12"/></WrapPanel></Grid>
            <ItemsControl x:Name="SourcesList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="15" Padding="18" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="42" Height="42" Background="#EFF4FE" CornerRadius="12"><local:ReferenceIcon Kind="folder" Foreground="#4273E8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="{Binding FullPath}" FontSize="11" Foreground="#96A2AF" Margin="0,5,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding CountLabel}" FontSize="11" Foreground="#96A2AF" Margin="0,4,0,0"/></StackPanel><CheckBox Grid.Column="2" IsChecked="{Binding IsIncluded, Mode=OneWay}" Checked="SourceVisibility_Click" Unchecked="SourceVisibility_Click" VerticalAlignment="Center" FocusVisualStyle="{StaticResource KeyboardFocus}" AutomationProperties.Name="{Binding VisibilityName}" Margin="0,0,12,0"><TextBlock Text="Показывать&#10;в библиотеке" FontSize="11" Foreground="#637187" Margin="5,0,0,0"/></CheckBox><TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock x:Name="NoSourcesText" Text="Пока нет источников. Добавьте первую папку." Style="{StaticResource MutedText}" Margin="0,0,0,20"/><TextBlock Text="Переключатели меняют только просмотр. Файлы, записи и миниатюры сохраняются; сканируются все добавленные источники. После нового запуска все источники показаны. Сохранённые миниатюры доступны и без исходного диска." Style="{StaticResource MutedText}" MaxWidth="680" HorizontalAlignment="Left" Margin="0,8,0,20"/><Button Content="Добавить папку" Click="AddFolder_Click" HorizontalAlignment="Left"/>
          </StackPanel>
        </StackPanel></ScrollViewer>
        <Grid Grid.Row="2" Margin="35,0,35,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock x:Name="Status" Text="Готово к работе" FontSize="11" Foreground="#798494" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/><TextBlock x:Name="Summary" Text="0 в библиотеке · 0 по фильтру" FontSize="10" Foreground="#9AA4B2"/></StackPanel><Button x:Name="ScanAction" Grid.Column="1" Content="Обновить" Click="Scan_Click" MinHeight="28" Height="28" Padding="10,0" FontSize="11" ToolTip="Повторное сканирование и поиск точных копий"/><StackPanel x:Name="Pages" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0"><Button Content="←" AutomationProperties.Name="Предыдущая страница" Click="PreviousPage_Click" Width="28" Height="28" MinHeight="28" Padding="0"/><TextBlock x:Name="PageCount" Text="1 / 1" VerticalAlignment="Center" Foreground="#778396" FontSize="11" Margin="8,0"/><Button Content="→" AutomationProperties.Name="Следующая страница" Click="NextPage_Click" Width="28" Height="28" MinHeight="28" Padding="0"/></StackPanel></Grid>
      </Grid>
    </Grid>
