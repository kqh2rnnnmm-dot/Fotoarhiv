<Window x:Class="Fotoarhiv.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Фотоархив" Width="1280" Height="840" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="#F7F9FC"
        FontFamily="Segoe UI" FontSize="14">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="212"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Background="#16243A" Grid.Column="0">
      <DockPanel Margin="20,24,12,16">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="6,0,0,37">
            <TextBlock Text="◈" Foreground="#9CB9FE" FontSize="24" Margin="0,0,12,0"/>
            <StackPanel>
              <TextBlock Text="Фотоархив" FontSize="21" FontWeight="SemiBold" Foreground="White"/>
              <TextBlock Text="Личная фотобиблиотека" FontSize="10.5" Foreground="#8BA4C2"/>
            </StackPanel>
          </StackPanel>
          <TextBlock Text="БИБЛИОТЕКА" Foreground="#8098B6" FontSize="10" Margin="12,0,0,11"/>
          <Button x:Name="NavPhotos" Content="▦   Фотографии" Click="NavigatePhotos_Click" Margin="0,0,0,9" HorizontalContentAlignment="Left" Background="#2E4669" Foreground="White"/>
          <Button x:Name="NavPlaces" Content="⌖   Места съёмки" Click="NavigatePlaces_Click" Margin="0,0,0,9" HorizontalContentAlignment="Left" Background="#22344E" Foreground="#D6E2F0"/>
          <Button x:Name="NavDuplicates" Content="▤   Точные повторы" Click="NavigateDuplicates_Click" Margin="0,0,0,9" HorizontalContentAlignment="Left" Background="#22344E" Foreground="#D6E2F0"/>
          <Button x:Name="NavSources" Content="▣   Источники" Click="NavigateSources_Click" Margin="0,0,0,9" HorizontalContentAlignment="Left" Background="#22344E" Foreground="#D6E2F0"/>
          <Border Height="1" Background="#344964" Margin="9,22,18,18"/>
          <TextBlock Text="ОРГАНИЗАЦИЯ" Foreground="#8098B6" FontSize="10" Margin="12,0,0,11"/>
          <Button Content="↗   Собрать архив" Click="ExportPlaceholder_Click" HorizontalContentAlignment="Left" Background="#22344E" Foreground="#D6E2F0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="10,0,0,5">
          <TextBlock Text="Версия 0.2.1 • тестовая" Foreground="#94A9C4" FontSize="11"/>
          <TextBlock Text="Оригиналы защищены" Foreground="#80CBA8" FontSize="11" Margin="0,5,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" Margin="30,25,28,20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="PageTitle" Text="Все фотографии" FontSize="26" FontWeight="SemiBold" Foreground="#17263B"/>
          <TextBlock x:Name="Summary" Text="Добавьте папку, чтобы создать библиотеку" FontSize="12" Foreground="#718096" Margin="0,5,0,0"/>
        </StackPanel>
        <Button Grid.Column="1" x:Name="AddFolderAction" Content="+ Добавить папку" Click="AddFolder_Click" Background="#2F66DA" Foreground="White" Margin="0,2,10,0"/>
        <Button Grid.Column="2" x:Name="ScanAction" Content="Обновить" Click="Scan_Click" Margin="0,2,0,0"/>
      </Grid>

      <Grid Grid.Row="1" x:Name="Filters" Margin="0,0,0,19">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="185"/></Grid.ColumnDefinitions>
        <TextBox x:Name="SearchBox" Height="38" TextChanged="Search_Changed" ToolTip="Поиск по имени и пути"/>
        <ComboBox x:Name="YearPicker" Grid.Column="1" Height="38" Margin="10,0,0,0" SelectionChanged="Year_Changed" FontSize="13" Padding="8,5"/>
      </Grid>

      <Grid Grid.Row="2">
        <!-- Gallery: page size is capped to avoid decoding thousands of full images at once. -->
        <Grid x:Name="PhotosPanel">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="PhotosGallery">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Width="202" Height="222" Margin="0,0,16,16" Background="White" CornerRadius="13" ClipToBounds="True"
                          MouseLeftButtonUp="Photo_Click" Cursor="Hand">
                    <StackPanel>
                      <Grid Height="158" Background="#E7ECF5">
                        <TextBlock Text="▧" FontSize="34" Foreground="#A0ADC0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#DDEBF7" CornerRadius="5" Margin="6" Padding="6,3">
                          <TextBlock Text="{Binding DateLabel}" FontSize="10" Foreground="#3A5873"/>
                        </Border>
                      </Grid>
                      <TextBlock Text="{Binding Name}" Margin="10,9,10,0" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Caption}" Margin="10,3,10,0" FontSize="11" Foreground="#718096" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>

        <Grid x:Name="PlacesPanel" Visibility="Collapsed">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Margin="2,0,0,14" Foreground="#586C83" TextWrapping="Wrap"
                       Text="Снимки с GPS. Выбери фотографию и нажми «Открыть точку». Карта открывается в браузере; координаты выбранного снимка будут переданы OpenStreetMap."/>
            <Button DockPanel.Dock="Bottom" Content="Открыть точку на карте" Click="OpenMap_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/>
            <ListBox x:Name="PlacesList" Background="White" BorderThickness="0" DisplayMemberPath="Description" FontSize="13"/>
          </DockPanel>
        </Grid>

        <Grid x:Name="DuplicatesPanel" Visibility="Collapsed">
          <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock Text="Группы точных совпадений" FontSize="13" Foreground="#596C83" Margin="0,0,0,11"/>
            <ListBox x:Name="DuplicateGroups" SelectionChanged="DuplicateGroup_Changed" DisplayMemberPath="Title" Background="White" BorderThickness="0"/>
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="Файлы в группе" FontSize="13" Foreground="#596C83" Margin="0,0,0,11"/>
            <ListBox x:Name="DuplicateMembers" Background="White" BorderThickness="0" DisplayMemberPath="Path"/>
            <TextBlock Text="Ничего не удаляется. Поиск выполняется по SHA-256 содержимого." TextWrapping="Wrap" FontSize="11" Foreground="#78889C" Margin="4,12,0,0"/>
          </StackPanel>
        </Grid>

        <Grid x:Name="SourcesPanel" Visibility="Collapsed">
          <StackPanel>
            <TextBlock Text="Папки, которые участвуют в общей библиотеке" FontSize="13" Foreground="#596C83" Margin="0,0,0,14"/>
            <ListBox x:Name="SourcesList" Height="270" Background="White" BorderThickness="0"/>
            <TextBlock Text="Если внешний диск отключён, записи остаются в каталоге. Когда диск вернётся, снимки станут доступными по прежнему пути." TextWrapping="Wrap" Foreground="#78889C" Margin="0,15,0,0"/>
          </StackPanel>
        </Grid>
      </Grid>

      <Grid Grid.Row="3" Margin="0,15,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="Status" Text="Готово к работе" FontSize="12" Foreground="#6A7C92" VerticalAlignment="Center"/>
        <StackPanel x:Name="Pages" Grid.Column="1" Orientation="Horizontal">
          <Button Content="←" Click="PreviousPage_Click"/>
          <TextBlock x:Name="PageCount" VerticalAlignment="Center" Margin="2,0,9,0" FontSize="12" Foreground="#556981"/>
          <Button Content="→" Click="NextPage_Click" Margin="0"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
